		"statusBarItem.focusBorder": "#007acc",
		"statusBarItem.prominentBackground": "#303030",
		"statusBarItem.remoteBackground": "#007acc",
		"statusBarItem.remoteForeground": "#ffffff",
		"titleBar.activeBackground": "#111111",
		"titleBar.activeForeground": "#999999",
		"titleBar.inactiveBackground": "#000000",
		"titleBar.inactiveForeground": "#656565",
		"commandCenter.background": "#181818",
		"commandCenter.border": "#303030",
		"commandCenter.foreground": "#999999",
		"commandCenter.activeBackground": "#202020",
		"menu.background": "#000000",
		"menu.foreground": "#dcdcdc",
		"menu.border": "#303030",
		"menu.selectionBackground": "#007acc",
		"menu.selectionForeground": "#ffffff",
		"menu.separatorBackground": "#303030",
		"menubar.selectionBackground": "#202020",
		"toolbar.hoverBackground": "#202020",
		"toolbar.activeBackground": "#303030",
