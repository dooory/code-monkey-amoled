		"statusBar.border": "#303030",
		"statusBar.focusBorder": "#007acc",
		"statusBar.noFolderBackground": "#111111",
		"statusBar.debuggingBackground": "#007acc",
		"statusBar.debuggingForeground": "#ffffff",
