		"breadcrumb.foreground": "#999999",
		"breadcrumb.focusForeground": "#dcdcdc",
		"breadcrumb.activeSelectionForeground": "#ffffff",
		"breadcrumbPicker.background": "#000000",
		"editor.background": "#000000",
		"editor.foreground": "#dcdcdc",
		"editor.lineHighlightBackground": "#111111",
		"editor.lineHighlightBorder": "#111111",
		"editor.selectionBackground": "#264f78",
		"editor.inactiveSelectionBackground": "#3a3b3d",
		"editorCursor.foreground": "#dcdcdc",
		"editorLineNumber.foreground": "#858585",
		"editorLineNumber.activeForeground": "#dcdcdc",
		"editorIndentGuide.background1": "#303030",
		"editorIndentGuide.activeBackground1": "#707070",
		"editorRuler.foreground": "#303030",
		"editorGutter.background": "#000000",
		"editorOverviewRuler.border": "#303030",
		"editorWidget.background": "#111111",
		"editorWidget.foreground": "#dcdcdc",
		"editorWidget.border": "#303030",
		"editorSuggestWidget.background": "#111111",
		"editorSuggestWidget.border": "#303030",
		"editorHoverWidget.background": "#111111",
		"editorHoverWidget.border": "#303030",
		"peekView.border": "#007acc",
		"peekViewTitle.background": "#111111",
		"peekViewEditor.background": "#080808",
		"peekViewResult.background": "#080808",
		"peekViewResult.selectionBackground": "#264f78",
		"panel.background": "#000000",
		"panel.border": "#303030",
		"panelTitle.activeBorder": "#007acc",
		"panelTitle.activeForeground": "#dcdcdc",
		"panelTitle.inactiveForeground": "#999999",
		"panelInput.border": "#303030",
		"panelSection.border": "#303030",
		"terminal.background": "#000000",
		"terminal.foreground": "#dcdcdc",
		"terminal.selectionBackground": "#264f78",
		"terminalCursor.foreground": "#dcdcdc",
		"terminal.tab.activeBorder": "#007acc",
