{
  "title": "Code Monkey AMOLED",
  "id": "CodeMonkeyAMOLED",
  "description": "Pure-black AMOLED variation of Code Monkey, retaining the original layout and blue accents.",
  "version": "1.0.0",
  "minAppVersion": "5.0.3",
  "type": "skin",
  "author": "mmuffins (original skin); AMOLED variant",
  "icon": "info.png",
  "skin_options": [
    {
      "type": "dropdown",
      "title": "Display size",
      "variable": "@baseFontSize",
      "default": "13",
      "options": {
        "12": "Compact",
        "13": "Normal",
        "14": "Cozy",
        "15": "Large",
        "17": "Huge"
      }
    },
    {
      "type": "radio",
      "default": "vs2022",
      "title": "Active tab background",
      "options": {
        "vs2022": {
          "title": "Dark",
          "variables": {
            "tabColor": ""
          }
        },
        "vs2019": {
          "title": "Colorful",
          "variables": {
            "tabColor": "@highlight2Color"
          }
        }
      }
    },
    {
      "type": "color",
      "default": "#264f78",
      "title": "Selection color",
      "variable": "@selectedColor",
      "visibilityCheck": "#dcdcdc"
    },
    {
      "type": "color",
      "default": "#1c97ea",
      "title": "Highlight color",
      "variable": "@highlightColor",
      "visibilityCheck": "#dcdcdc"
    },
    {
      "type": "color",
      "default": "#007acc",
      "title": "Secondary highlight color",
      "variable": "@highlight2Color",
      "visibilityCheck": "#dcdcdc"
    }
  ]
}
